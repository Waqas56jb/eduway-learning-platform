# EDUWAY student app — copy to `.env` and restart Expo (`npx expo start -c`).
#
# Base URL of the EDUWAY API including /api/v1.
# - iOS simulator / web on the same computer: http://localhost:4100/api/v1
# - Android emulator:                          http://10.0.2.2:4100/api/v1
# - Real phone (Expo Go): your computer's LAN IP, e.g. http://192.168.1.20:4100/api/v1
#   (phone and computer on the same Wi-Fi; allow port 4100 in the firewall), or an HTTPS tunnel URL
#   such as https://<id>.ngrok-free.app/api/v1 / a deployed server.
EXPO_PUBLIC_API_URL=http://localhost:4100/api/v1
