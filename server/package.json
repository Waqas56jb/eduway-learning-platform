{
  "name": "eduway-server",
  "version": "1.0.0",
  "private": true,
  "description": "EDUWAY platform backend (Express 5 + TypeScript + Supabase). All DB objects prefixed eduway_platform_.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/src/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "cross-env TEST=1 vitest run --project integration",
    "smoke": "tsx scripts/smoke.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check-prefix": "tsx scripts/check-prefix.ts",
    "docs": "tsx scripts/generate-openapi.ts",
    "buckets": "tsx scripts/storage-buckets.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "check-env": "tsx scripts/check-env.ts",
    "migrate:list": "tsx scripts/migrate.ts --list-objects",
    "db:objects": "tsx scripts/list-objects.ts",
    "verify": "npm run check-prefix && npm run typecheck && npm run lint && npm run test && npm run migrate && npm run seed && npm run db:objects"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@supabase/supabase-js": "^2.118.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "otplib": "^12.0.1",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  }
}
