# EDUWAY server — copy to .env and fill in. NEVER commit .env. All values below are placeholders.
NODE_ENV=development
PORT=4100
API_PREFIX=/api/v1
# LOG_LEVEL=debug

# ── Supabase (shared project — every object we create is prefixed eduway_platform_) ──
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# SUPABASE_SECRET_KEY=<optional new-style secret key>
# Session pooler URI (Dashboard → Connect → Session pooler), port 5432
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Supabase session pooler (Nano) allows ~15 clients across ALL processes; each API process uses DB_POOL_MAX + 3 (pg-boss).
DB_POOL_MAX=4
DB_SSL=true
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_CONNECT_TIMEOUT_MS=10000
# Mirror students/admins into Supabase Auth with app_metadata.app = "eduway_platform" (best effort)
SUPABASE_AUTH_MIRROR=true

# ── JWT (min 32 chars each; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ──
JWT_ACCESS_SECRET=<random-48-bytes>
JWT_REFRESH_SECRET=<random-48-bytes>
JWT_ADMIN_SECRET=<random-48-bytes>
# JWT_ISSUER=eduway-platform
# ACCESS_TOKEN_TTL_SEC=900
# REFRESH_TOKEN_TTL_DAYS=30
# ADMIN_ACCESS_TOKEN_TTL_SEC=900
# ADMIN_REFRESH_TOKEN_TTL_DAYS=7

# ── Clients ──
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081
ADMIN_APP_URL=http://localhost:5174
USER_APP_URL=http://localhost:5173

# ── Providers ── every external provider is plug-in: set the credentials + flip the *_PROVIDER switch.
#    A provider whose credentials are missing falls back to its mock (the server always starts); the startup log
#    prints one line per provider with the active implementation. Full guide: docs/PROVIDERS.md

# SMS / WhatsApp (OTP + notifications). SMS_PROVIDER = mock | twilio | whatsapp_cloud | http
SMS_PROVIDER=mock
# WHATSAPP_PROVIDER=twilio        # channel `whatsapp`; defaults to SMS_PROVIDER (mock | twilio | whatsapp_cloud | http)
# Twilio (console.twilio.com → Account Info)
# TWILIO_ACCOUNT_SID=AC<...>
# TWILIO_AUTH_TOKEN=<auth-token>
# TWILIO_FROM=+1<sms-capable-number>            # or:
# TWILIO_MESSAGING_SERVICE_SID=MG<...>
# TWILIO_WHATSAPP_FROM=+1<whatsapp-sender>       # approved WhatsApp sender (no "whatsapp:" prefix)
# TWILIO_WHATSAPP_CONTENT_SID=HX<...>            # approved OTP Content template, variable {{1}} = code
# Meta WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup)
# WHATSAPP_CLOUD_TOKEN=<system-user-permanent-token>
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=<phone-number-id>
# WHATSAPP_CLOUD_API_VERSION=v21.0
# WHATSAPP_CLOUD_OTP_TEMPLATE=<approved-authentication-template-name>
# WHATSAPP_CLOUD_TEMPLATE_LANG=ar
# WHATSAPP_CLOUD_OTP_BUTTON=true                 # false if the template has no copy-code button
# WHATSAPP_CLOUD_NOTIFY_TEMPLATE=<utility-template-name>   # optional, body {{1}} = notification text
# Generic HTTP gateway (POST {to,text,channel} with a bearer token)
# SMS_HTTP_URL=https://sms.example.com/send
# SMS_HTTP_TOKEN=<token>

# Email. EMAIL_PROVIDER = mock | smtp (unset: smtp when SMTP_URL/SMTP_HOST is set, else mock)
# EMAIL_PROVIDER=smtp
# SMTP_URL=smtps://user:pass@smtp.example.com:465       # either a URL…
# SMTP_HOST=smtp.example.com                            # …or host/port/user/pass
# SMTP_PORT=587
# SMTP_SECURE=false                                     # true = implicit TLS (465); default by port
# SMTP_USER=<user>
# SMTP_PASS=<password>
MAIL_FROM=EDUWAY <no-reply@eduway.iq>

# ── AI tutor — without a key the tutor uses the built-in mock model ──
# AI_PROVIDER=anthropic           # mock | anthropic | openai | azure — overrides the admin setting when set
# ANTHROPIC_API_KEY=<key>         # console.anthropic.com → API keys
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_SERVER_FALLBACK=true  # server-side refusal fallback; set false behind proxies that strip betas
# OPENAI_API_KEY=<key>            # platform.openai.com → API keys (also enables vector embeddings)
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
# AZURE_OPENAI_API_KEY=<key>
# AZURE_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
# AI_FORCE_MOCK=false
# AI_EMBEDDING_MODEL=<embedding-model>

# ── Push / notifications ──
# PUSH_PROVIDER=auto              # auto (expo in production, mock elsewhere) | expo | mock
# EXPO_ACCESS_TOKEN=<token>       # expo.dev → Account settings → Access tokens (needed if push security is enabled)
# NOTIFICATION_WEBHOOK_SECRET=<random-32+>

# ── Payments — a gateway without its credentials is a stub: production rejects it (PAYMENT_GATEWAY_DISABLED),
#    development confirms it through the MockGateway (POST /payments/mock/:id/confirm).
#    Real gateways need PUBLIC_API_URL (public HTTPS base of this API) for callback/notification URLs:
#      callback  {PUBLIC_API_URL}/api/v1/payments/callback/<gateway>
#      webhook   {PUBLIC_API_URL}/api/v1/payments/webhook/<gateway>
# MOCK_GATEWAY_SECRET=<random-32+>          # defaults to a value derived from JWT_REFRESH_SECRET
# PUBLIC_API_URL=https://api.eduway.iq
# PAYMENT_CHECKOUT_TTL_MIN=30
# ZainCash (merchant onboarding with ZainCash; test credentials from their developer docs)
# ZAINCASH_MERCHANT_ID=<merchant-id>
# ZAINCASH_SECRET=<merchant-secret>         # JWT signing secret
# ZAINCASH_MSISDN=<merchant-wallet-msisdn>  # e.g. 9647835077893
# ZAINCASH_ENV=test                         # test | live
# ZAINCASH_LANG=ar                          # ar | en | ku
# ZAINCASH_SERVICE_TYPE=EDUWAY subscription
# FastPay (FastPay merchant panel → store credentials)
# FASTPAY_STORE_ID=<store-id>
# FASTPAY_SECRET=<store-password>
# FASTPAY_ENV=staging                       # staging | live
# Qi Card (Qi merchant onboarding → terminal + API user)
# QICARD_TERMINAL_ID=<terminal-id>
# QICARD_USERNAME=<api-username>
# QICARD_SECRET=<api-password>
# QICARD_ENV=uat                            # uat | live
# QICARD_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"   # optional, once Qi confirms the signature scheme
# AsiaHawala / Visa-Mastercard: stub only (HMAC webhooks) until a merchant contract exists
# ASIAHAWALA_MERCHANT_ID=<id>
# ASIAHAWALA_SECRET=<secret>
# VISA_MERCHANT_ID=<id>
# VISA_SECRET=<secret>

# ── Jobs / storage ──
JOBS_ENABLED=true
# Serve /api/docs (Swagger + openapi.json) in production as well (off by default in production)
API_DOCS_PUBLIC=false
SIGNED_URL_TTL_SEC=3600

# ── Seed ──
SEED_SUPER_ADMIN_EMAIL=admin@eduway.iq
# Strong password (≥10 chars, upper, lower, digit, symbol). If empty, `npm run seed` generates one and prints it ONCE.
SEED_SUPER_ADMIN_PASSWORD=

# Integration tests only: TEST=1 switches every object to the eduway_platform_test_ prefix.
# TEST=1
# RATE_LIMIT_IN_TESTS=1   # integration tests only: exercise the rate limiters under NODE_ENV=test
